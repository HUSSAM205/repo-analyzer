DATABASE_URL=postgresql+asyncpg://repoanalyzer:repoanalyzer@localhost:5432/repoanalyzer
REDIS_URL=redis://localhost:6379/0
JWT_PRIVATE_KEY_PATH=keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=keys/jwt_public.pem
# Inline alternative to the two paths above -- set JWT_PRIVATE_KEY/
# JWT_PUBLIC_KEY instead (raw PEM text or base64 of it) on a platform where
# uploading a Secret File isn't convenient/automatable. Takes priority over
# the path settings when set. Leave unset for local dev.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ALGORITHM=RS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
EMBEDDING_MODEL_NAME=microsoft/codebert-base
MAX_REPO_SIZE_MB=500
MAX_FILES_PER_REPO=5000
RATE_LIMIT_ANALYZE_PER_MINUTE=5
RATE_LIMIT_CHAT_PER_MINUTE=15
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# Local last-resort fallback when Groq is rate-limited/unreachable (see
# GroqClient in app/core/llm_providers.py). Leave OLLAMA_MODEL empty to
# disable it entirely -- e.g. in a cloud deployment with no local Ollama
# server reachable at OLLAMA_BASE_URL, where a doomed connection attempt on
# every cloud failure just adds latency for no benefit.
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=qwen2.5-coder:7b

# Comma-separated browser origins allowed to call this API directly, or "*"
# for any origin. Leave empty unless something calls this API straight from
# a browser -- the bundled Next.js frontend proxies every call server-side
# and never needs this set. See app/config.py's Settings.cors_allowed_origins.
CORS_ALLOWED_ORIGINS=
